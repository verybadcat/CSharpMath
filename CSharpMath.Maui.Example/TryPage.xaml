<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:math="clr-namespace:CSharpMath.Maui;assembly=CSharpMath.Maui"
             xmlns:local="clr-namespace:CSharpMath.Maui.Example"
             x:Class="CSharpMath.Maui.Example.TryPage"
             Title="Try">
    <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*">
        <Entry x:Name="Entry" Grid.Row="0"/>
        <Label x:Name="Exit" Grid.Row="1"/>
        <HorizontalStackLayout Grid.Row="2">
            <Picker x:Name="Size"
                    ItemsSource="{x:Static local:TryPage.FontSizes}"/>
            <Button Text="Reset pan" Clicked="Button_Clicked" HorizontalOptions="End"/>
        </HorizontalStackLayout>
        <math:MathView x:Name="View" EnablePanning="True" TextColor="{x:StaticResource Primary}" Grid.Row="3" />
    </Grid>

</ContentPage>
